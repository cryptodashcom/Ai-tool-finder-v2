# Marketing OS v3 — Environment Variables Template
# Copy to .env and fill in your values.

# ── AI / Generation ──────────────────────────────────
OPENAI_API_KEY=
MINIMAX_API_KEY=

# ── Notion ───────────────────────────────────────────
NOTION_API_KEY=
BRAND_BIBLE_PAGE_ID=
PROMPTS_DB_ID=
CAMPAIGNS_DB_ID=

# ── Competitor Intelligence ───────────────────────────
APIFY_TOKEN=
COMPETITOR_PROFILES=https://instagram.com/brand1,https://instagram.com/brand2

# ── Platform Tokens ──────────────────────────────────
FB_PAGE_ID=
FB_GROUP_ID=
FB_PAGE_TOKEN=
INSTAGRAM_BUSINESS_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_BEARER_TOKEN=
PINTEREST_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# ── Storage & Infrastructure ──────────────────────────
# Choose one:
S3_BUCKET=
CLOUDINARY_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=marketing_os
POSTGRES_PASSWORD=
POSTGRES_DB=marketing_os

# ── Slack ─────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=#marketing-approvals
SLACK_ERROR_CHANNEL=#marketing-errors

# ── Dashboard ─────────────────────────────────────────
DASHBOARD_WEBHOOK_URL=

# ── System Behaviour ──────────────────────────────────
AUDIENCE_TIMEZONE=America/New_York
ENGAGEMENT_POLL_INTERVAL=*/30 * * * *
QUALITY_SCORE_THRESHOLD_AUTO=80
QUALITY_SCORE_THRESHOLD_REVIEW=60
