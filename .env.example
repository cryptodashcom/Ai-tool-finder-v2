# ── Claude / Anthropic ──────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── ProductHunt ──────────────────────────────────────────────────────────────
# Get your token at: https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_API_KEY=your_producthunt_token

# ── GitHub ───────────────────────────────────────────────────────────────────
# Create a Personal Access Token at: https://github.com/settings/tokens
# Needs no special scopes (public repo search is enough)
GITHUB_TOKEN=ghp_...

# ── Reddit ───────────────────────────────────────────────────────────────────
# Create an app at: https://www.reddit.com/prefs/apps  (type: script)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...

# ── AgentsDash.ai Publishing ─────────────────────────────────────────────────
# Your AgentsDash.ai backend API base URL  (no trailing slash)
# The system will POST approved agents to: {AGENTSDASH_API_URL}/agents
AGENTSDASH_API_URL=https://agentsdash.ai/api
# Bearer token for your AgentsDash.ai API
AGENTSDASH_API_KEY=your_agentsdash_api_key
